{
  "name": "@executioncontrolprotocol/docs",
  "version": "1.0.0",
  "description": "Mintlify documentation site for the Execution Control Protocol (ECP) — Fluent API era",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mintlify dev",
    "build:typedoc": "typedoc",
    "broken-links": "mintlify broken-links",
    "validate": "mintlify validate && mintlify broken-links",
    "secrets:scan": "secretlint \"**/*\"",
    "clean": "node scripts/clean-dist.mjs",
    "clean:coverage": "node scripts/clean-dist.mjs coverage",
    "clean:dist": "node scripts/clean-dist.mjs dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "secretlint --no-glob"
    ]
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mintlify": "^4.0.0",
    "secretlint": "^13.0.4",
    "typedoc": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
