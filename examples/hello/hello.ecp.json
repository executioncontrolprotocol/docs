{
  "schema": "@executioncontrolprotocol.execution",
  "version": "2.0",
  "execution": {
    "id": "hello",
    "label": "Hello world transform"
  },
  "steps": [
    {
      "id": "greet",
      "uses": "@executioncontrolprotocol/core.transform",
      "accepts": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "returns": {
        "type": "object",
        "properties": {
          "greeting": {
            "type": "string"
          }
        },
        "required": [
          "greeting"
        ]
      },
      "input": {
        "name": "world"
      },
      "script": {
        "lang": "js",
        "source": "return { greeting: `Hello, ${input.name}!` }"
      },
      "as": "hello"
    }
  ]
}
